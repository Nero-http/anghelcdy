---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Message Sent | Anghel Dy</title>
</head>
<body class="bg-[#f4f0e8] text-[#171717] dark:bg-[#101010] dark:text-[#f4f0e8]">
<main class="flex min-h-screen items-center justify-center bg-[#f4f0e8] px-5 py-8 dark:bg-[#101010] sm:px-8">
    <section
        aria-labelledby="success-title"
        class="w-full max-w-xl border-[3px] border-[#171717] bg-[#eaff00] p-5 text-[#171717] shadow-[8px_8px_0_#171717] sm:p-8"
        data-reveal-group
    >
        <div class="flex items-center justify-between gap-4 border-b-[3px] border-[#171717] pb-4">
            <p class="text-xs font-black uppercase tracking-[2px]">
                Message received
            </p>

            <span
                aria-label="Message sent successfully"
                class="flex h-9 w-9 shrink-0 items-center justify-center border-[3px] border-[#171717] bg-[#171717] text-xl font-black text-[#eaff00]"
            >
                ✓
            </span>
        </div>

        <div class="py-7 sm:py-9" data-reveal-item data-reveal-from="left">
            <p class="mb-3 text-xs font-black uppercase tracking-[2px]">
                Your note is on its way
            </p>

            <h1
                id="success-title"
                class="text-5xl font-black uppercase leading-[0.85] tracking-tighter sm:text-7xl md:text-8xl"
            >
                THANK<br>
                YOU!
            </h1>

            <p class="mt-6 max-w-lg border-l-[5px] border-[#171717] pl-4 text-base font-bold leading-relaxed">
                Your message has been successfully sent.
                Thanks for reaching out! I'll get back to you as soon as possible.
            </p>

            <a
                href="/"
                class="btn-primary mt-6 inline-flex items-center justify-center gap-3"
            >
                <span aria-hidden="true">←</span>
                BACK TO HOME
            </a>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t-[3px] border-[#171717] pt-4">
            <p class="text-[10px] font-black uppercase tracking-widest">
                Thanks for getting in touch.
            </p>

            <p class="text-xs font-black uppercase">
                Message sent ✓
            </p>
        </div>
    </section>
</main>
</body>
</html>
