---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "./index/sections/About.astro";
import Contact from "./index/sections/Contact.astro";
import Hero from "./index/sections/Hero.astro";
import Projects from "./index/sections/Projects.astro";
const name = "Anghel Dy";
const position = "Web Developer / 	Software Engineer";
---

<BaseLayout>
	<main id="home" class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
		<Hero />
		<div id="build" class="my-16 border-y-[3px] border-[#171717] bg-[#171717] py-4 text-center text-[#eaff00]">
			<p class="font-black uppercase tracking-widest">
				Build different ✳ Think bigger ✳ Ship better ✳
			</p>
		</div>
		<Projects />
		<About />
		<Contact />
	</main>
</BaseLayout>